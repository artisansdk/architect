{
    "entry": ["tests/**/*.test.ts", "tests/**/*.test.tsx"],
    "ignorePatterns": [
        "*test*",
        "examples/**",
        "tests/**",
        "scripts/**",
        "coverage/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "docs/book/theme*.js"
    ],
    "overrides": [
        {
            "files": ["examples/**/*"],
            "rules": {
                "unused-class-members": "off"
            }
        }
    ],
    "usedClassMembers": [
        {
            "extends": "ServiceProvider",
            "members": ["register", "boot"]
        }
    ]
}
